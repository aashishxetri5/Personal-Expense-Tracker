# --- Required -------------------------------------------------------------
# PostgreSQL connection string.
# On Vercel, create a database (Neon / Supabase / Prisma Postgres / Vercel
# Postgres) and paste the POOLED connection string here.
DATABASE_URL="postgresql://user:password@host:5432/finance?sslmode=require"

# --- Optional -------------------------------------------------------------
# Only needed locally, for "prisma migrate dev". Never set this in production.
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/finance_shadow"

# Locally you can skip both: run "npx prisma dev -d -n expense-tracker" to get a
# throwaway Postgres, then "npx prisma dev ls" to read its TCP url.
