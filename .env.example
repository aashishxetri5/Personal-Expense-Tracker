# --- Required -------------------------------------------------------------
# PostgreSQL connection string.
# On Vercel, create a database (Neon / Supabase / Prisma Postgres / Vercel
# Postgres) and paste the POOLED connection string here.
DATABASE_URL="postgresql://user:password@host:5432/finance?sslmode=require"

# The password that unlocks the app. Without it the app refuses to serve data.
APP_PASSWORD="choose-a-long-password"

# Signs the session cookie. At least 32 random characters, and keep it secret.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET="replace-with-32-or-more-random-characters"

# --- Optional -------------------------------------------------------------
# Only needed locally, for "prisma migrate dev". Never set this in production.
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/finance_shadow"

# Locally you can skip the database URLs: run
# "npx prisma dev -d -n expense-tracker" for a throwaway Postgres, then
# "npx prisma dev ls" to read its TCP url.
